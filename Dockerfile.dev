# Menggunakan Node.js versi LTS berbasis Alpine yang ringan
FROM node:20-alpine

# Tentukan working directory di dalam container
WORKDIR /app

# Copy package.json dan package-lock.json terlebih dahulu untuk optimasi cache
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy seluruh source code ke dalam container
COPY . .

# Expose port yang digunakan oleh Vite
EXPOSE 5173

# Jalankan perintah untuk development
CMD ["npm", "run", "dev"]